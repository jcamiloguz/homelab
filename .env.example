# Copy to .env and fill in locally. NEVER commit .env.
TZ=Etc/UTC
DATA_DIR=/srv/homelab

# Pi-hole
PIHOLE_PASSWORD=changeme

# Hermes Agent + Open WebUI
HERMES_API_KEY=changeme            # must equal API_SERVER_KEY in ~hermes/.hermes/.env
WEBUI_SECRET_KEY=changeme          # openssl rand -hex 32
OPENWEBUI_ENABLE_SIGNUP=true       # false after creating the admin account

# Hub (services/hub) — image ghcr.io/jcamiloguz/hub (private: docker login ghcr.io first)
HUB_VERSION=latest                 # latest = auto-deploy each release; X.Y.Z = pinned
HUB_OWNER_LOGIN=owner@example.com  # your Tailscale login (real value only on the Pi)
HUB_MCP_TOKEN=changeme             # openssl rand -hex 32; same value in ~hermes/.hermes/.env
